{
  "name": "xitjs",
  "version": "0.1.0",
  "private": true,
  "description": "Parse and write [x]it! (.xit) todo documents: spec-compliant, lossless, dependency-free",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./codemirror": {
      "types": "./dist/codemirror.d.ts",
      "default": "./dist/codemirror.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "test:fuzz": "XIT_FUZZ=50 node --test test/round-trip.test.ts test/tokenize.test.ts test/codemirror.test.ts test/groups.test.ts",
    "test:watch": "node --test --watch 'test/**/*.test.ts'",
    "test:dist": "tsc -p tsconfig.build.json && node test/dist-smoke.js",
    "demo": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.demo.json",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.13.1",
    "@lezer/highlight": "^1.2.5"
  },
  "peerDependenciesMeta": {
    "@codemirror/language": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^26.6.5",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
